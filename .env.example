PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# "providers" uses SendGrid for email and Twilio for SMS. "console" is local-only.
DELIVERY_MODE=providers

# SendGrid email delivery
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=